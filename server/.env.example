PORT=5000
NODE_ENV=development

# Firebase configuration placeholders
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Server-only Firebase Admin SDK credentials. Keep the service account JSON private
# and outside source control. For Render, set FIREBASE_SERVICE_ACCOUNT_JSON to the
# complete JSON contents in the dashboard's secret environment variable editor.
# For local development, either provide that JSON or use an absolute key-file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIRST_ADMIN_EMAIL=admin@example.com
